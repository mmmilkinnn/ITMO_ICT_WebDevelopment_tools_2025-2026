le":"\u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438","text":"<ul> <li><code>GET /api/users/me</code></li> <li><code>GET /api/users</code></li> </ul>"},{"location":"lab1/#_16","title":"\u0425\u0430\u043a\u0430\u0442\u043e\u043d\u044b","text":"<ul> <li><code>POST /api/hackathons</code></li> <li><code>GET /api/hackathons</code></li> <li><code>GET /api/hackathons/{hackathon_id}</code></li> <li><code>PATCH /api/hackathons/{hackathon_id}</code></li> <li><code>DELETE /api/hackathons/{hackathon_id}</code></li> <li><code>POST /api/hackathons/{hackathon_id}/register</code></li> <li><code>GET /api/hackathons/{hackathon_id}/registrations</code></li> <li><code>PATCH /api/hackathons/registrations/{registration_id}</code></li> </ul>"},{"location":"lab1/#_17","title":"\u041a\u043e\u043c\u0430\u043d\u0434\u044b","text":"<ul> <li><code>POST /api/teams</code></li> <li><code>GET /api/teams</code></li> <li><code>GET /api/teams/{team_id}</code></li> <li><code>PATCH /api/teams/{team_id}</code></li> <li><code>DELETE /api/teams/{team_id}</code></li> <li><code>POST /api/teams/{team_id}/join</code></li> </ul>"},{"location":"lab1/#_18","title":"\u0417\u0430\u0434\u0430\u0447\u0438","text":"<ul> <li><code>POST /api/tasks</code></li> <li><code>GET /api/tasks</code></li> <li><code>GET /api/tasks/{task_id}</code></li> <li><code>PATCH /api/tasks/{task_id}</code></li> <li><code>DELETE /api/tasks/{task_id}</code></li> </ul>"},{"location":"lab1/#_19","title":"\u0420\u0435\u0448\u0435\u043d\u0438\u044f","text":"<ul> <li><code>POST /api/submissions</code></li> <li><code>GET /api/submissions</code></li> <li><code>GET /api/submissions/{submission_id}</code></li> <li><code>PATCH /api/submissions/{submission_id}</code></li> <li><code>DELETE /api/submissions/{submission_id}</code></li> </ul>"},{"location":"lab1/#_20","title":"\u041e\u0446\u0435\u043d\u043a\u0438","text":"<ul> <li><code>POST /api/reviews</code></li> <li><code>GET /api/reviews</code></li> <li><code>GET /api/reviews/{review_id}</code></li> <li><code>PATCH /api/reviews/{review_id}</code></li> <li><code>DELETE /api/reviews/{review_id}</code></li> </ul>"},{"location":"lab1/#get-","title":"\u0412\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0435 GET-\u0437\u0430\u043f\u0440\u043e\u0441\u044b","text":""},{"location":"lab1/#get-apihackathonshackathon_id","title":"<code>GET /api/hackathons/{hackathon_id}</code>","text":"<p>\u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442:</p> <ul> <li>\u0434\u0430\u043d\u043d\u044b\u0435 \u0445\u0430\u043a\u0430\u0442\u043e\u043d\u0430;</li> <li>\u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0442\u043e\u0440\u0430;</li> <li>\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438;</li> <li>\u043a\u043e\u043c\u0430\u043d\u0434\u044b;</li> <li>\u0437\u0430\u0434\u0430\u0447\u0438.</li> </ul>"},{"location":"lab1/#get-apiteamsteam_id","title":"<code>GET /api/teams/{team_id}</code>","text":"<p>\u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442:</p> <ul> <li>\u0434\u0430\u043d\u043d\u044b\u0435 \u043a\u043e\u043c\u0430\u043d\u0434\u044b;</li> <li>\u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u044f \u043a\u043e\u043c\u0430\u043d\u0434\u044b;</li> <li>\u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u043e\u0432 \u043a\u043e\u043c\u0430\u043d\u0434\u044b \u0441 \u0440\u043e\u043b\u044f\u043c\u0438.</li> </ul>"},{"location":"lab1/#get-apisubmissionssubmission_id","title":"<code>GET /api/submissions/{submission_id}</code>","text":"<p>\u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442:</p> <ul> <li>\u0434\u0430\u043d\u043d\u044b\u0435 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u044f;</li> <li>\u0437\u0430\u0434\u0430\u0447\u0443;</li> <li>\u043a\u043e\u043c\u0430\u043d\u0434\u0443;</li> <li>\u0430\u0432\u0442\u043e\u0440\u0430 \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0438;</li> <li>\u043e\u0446\u0435\u043d\u043a\u0438.</li> </ul>"},{"location":"lab1/#_21","title":"\u041f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u043a \u0431\u0430\u0437\u0435 \u0434\u0430\u043d\u043d\u044b\u0445","text":"<p>\u041f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442\u0441\u044f \u0432 \u0444\u0430\u0439\u043b\u0435 <code>app/db/session.py</code> \u0447\u0435\u0440\u0435\u0437 <code>create_engine</code> \u0438 <code>sessionmaker</code>.</p> <p>\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f PostgreSQL.</p> <p>\u041f\u0440\u0438\u043c\u0435\u0440 \u0441\u0442\u0440\u043e\u043a\u0438 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f:</p> <pre><code>DATABASE_URL = \"postgresql+psycopg://postgres:1234@localhost:5432/hackathon_lab1\"\n</code></pre>"},{"location":"lab1/#_22","title":"\u041c\u0438\u0433\u0440\u0430\u0446\u0438\u0438","text":"<p>\u0414\u043b\u044f \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0441\u0445\u0435\u043c\u043e\u0439 \u0431\u0430\u0437\u044b \u0434\u0430\u043d\u043d\u044b\u0445 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f Alembic.</p>"},{"location":"lab1/#_23","title":"\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043a\u043e\u043c\u0430\u043d\u0434\u044b","text":"<p>\u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043c\u0438\u0433\u0440\u0430\u0446\u0438\u0438:</p> <pre><code>alembic revision --autogenerate -m \"initial schema\"\n</code></pre> <p>\u041f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u043c\u0438\u0433\u0440\u0430\u0446\u0438\u0438:</p> <pre><code>alembic upgrade head\n</code></pre>"},{"location":"lab1/#_24","title":"\u0417\u0430\u043f\u0443\u0441\u043a \u043f\u0440\u043e\u0435\u043a\u0442\u0430","text":""},{"location":"lab1/#1_1","title":"1. \u041f\u0435\u0440\u0435\u0439\u0442\u0438 \u0432 \u043f\u0430\u043f\u043a\u0443 \u043f\u0440\u043e\u0435\u043a\u0442\u0430","text":"<pre><code>cd students/k3339/Markozubova_Anastasia/lab1/laboratory\n</code></pre>"},{"location":"lab1/#2","title":"2. \u0410\u043a\u0442\u0438\u0432\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0435 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u0435","text":"<pre><code>venv\\Scripts\\activate\n</code></pre>"},{"location":"lab1/#3","title":"3. \u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438","text":"<pre><code>pip install fastapi uvicorn sqlalchemy alembic \"psycopg[binary]\" pydantic email-validator\n</code></pre>"},{"location":"lab1/#4-postgresql","title":"4. \u0421\u043e\u0437\u0434\u0430\u0442\u044c \u0431\u0430\u0437\u0443 \u0434\u0430\u043d\u043d\u044b\u0445 PostgreSQL","text":"<p>\u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0431\u0430\u0437\u0443 \u0434\u0430\u043d\u043d\u044b\u0445:</p> <pre><code>hackathon_lab1\n</code></pre>"},{"location":"lab1/#5","title":"5. \u041f\u0440\u0438\u043c\u0435\u043d\u0438\u0442\u044c \u043c\u0438\u0433\u0440\u0430\u0446\u0438\u0438","text":"<pre><code>alembic upgrade head\n</code></pre>"},{"location":"lab1/#6","title":"6. \u0417\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435","text":"<pre><code>uvicorn app.main:app --reload\n</code></pre>"},{"location":"lab1/#7-swagger","title":"7. \u041e\u0442\u043a\u0440\u044b\u0442\u044c Swagger","text":"<pre><code>http://127.0.0.1:8000/docs\n</code></pre>"},{"location":"lab1/#_25","title":"\u0412\u044b\u0432\u043e\u0434","text":"<p>\u0412 \u0440\u0430\u043c\u043a\u0430\u0445 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b \u0431\u044b\u043b\u043e \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043e \u0441\u0435\u0440\u0432\u0435\u0440\u043d\u043e\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043d\u0430 FastAPI \u043f\u043e \u0442\u0435\u043c\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0445\u0430\u043a\u0430\u0442\u043e\u043d\u043e\u0432. \u0412 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u044b ORM-\u043c\u043e\u0434\u0435\u043b\u0438, PostgreSQL, \u043c\u0438\u0433\u0440\u0430\u0446\u0438\u0438 Alembic, CRUD-\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438, JWT-\u0430\u0443\u0442\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f, \u0445\u044d\u0448\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0430\u0440\u043e\u043b\u0435\u0439 \u0438 \u0432\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u0435 GET-\u0437\u0430\u043f\u0440\u043e\u0441\u044b. \u0421\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430 \u043f\u0440\u043e\u0435\u043a\u0442\u0430 \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0430 \u043d\u0430 \u043c\u043e\u0434\u0443\u043b\u0438, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u043a\u043e\u0434 \u043f\u043e\u043d\u044f\u0442\u043d\u044b\u043c \u0438 \u0443\u0434\u043e\u0431\u043d\u044b\u043c \u0434\u043b\u044f \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0433\u043e \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u044f.</p>"}]}